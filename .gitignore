
# Clarity .gitignore
functions/serviceAccountKey.json

# API Keys & Firebase — NEVER commit these
Secrets.xcconfig
Clarity/Core/Secrets.swift
Clarity/GoogleService-Info.plist
GoogleService-Info.plist
fastlane/api_key.json
fastlane/AuthKey_*.p8
.DS_Store
*.xcuserstate
xcuserdata/

# Logs and Build Artifacts
*.log
*.txt

# ...pero la ficha de la App Store sí se versiona: los textos, las keywords y
# las novedades son trabajo, y con `*.txt` a secas quedaban solo en el disco de
# quien los escribió, sin historial de qué decía la ficha antes.
!fastlane/metadata/**/*.txt
# Salvo las credenciales de la cuenta de prueba para la revisión de Apple.
fastlane/metadata/review_information/
*.xcactivitylog
build/
DerivedData/
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
